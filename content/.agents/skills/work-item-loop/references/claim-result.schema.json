{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": { "type": "string", "enum": ["claimed", "empty", "blocked", "error"] },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "attempt": { "type": "integer", "minimum": 1 }
        },
        "required": ["id", "title", "attempt"]
      }
    },
    "message": { "type": "string" }
  },
  "required": ["status", "items", "message"]
}
