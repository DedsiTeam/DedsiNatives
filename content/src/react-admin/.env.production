# 生产环境配置
VITE_API_SERVICE_URL=http://api.yourdomain.com

# SSO 单点登录 (OpenIddict / OIDC) 配置
VITE_SSO_AUTHORITY=http://sso.yourdomain.com
VITE_SSO_CLIENT_ID=dedsinative-web
VITE_SSO_REDIRECT_URI=http://admin.yourdomain.com/callback
VITE_SSO_POST_LOGOUT_REDIRECT_URI=http://admin.yourdomain.com/login
VITE_SSO_SCOPE=openid profile email roles dedsinative_api
