<Project>
    <!-- 集中维护 NuGet 版本；Update 只设置项目已有引用，不为所有项目添加依赖。 -->
    <!-- 新增包时，在项目中添加无版本的 PackageReference，并在此补充版本。 -->
    <!-- Aspire.AppHost.Sdk 在项目求值前解析，其版本由 global.json 管理。 -->
    <ItemGroup>
        <PackageReference Update="Aspire.Hosting.PostgreSQL" Version="13.6.3" />
        <PackageReference Update="Aspire.Hosting.RabbitMQ" Version="13.6.3" />
        <PackageReference Update="Aspire.Hosting.Redis" Version="13.6.3" />
        <PackageReference Update="Aspire.Hosting.Seq" Version="13.6.3" />
        <PackageReference Update="Aspire.StackExchange.Redis.DistributedCaching" Version="13.6.3" />
        <PackageReference Update="CommunityToolkit.Aspire.Hosting.Minio" Version="13.5.0" />
        <PackageReference Update="Dedsi.CleanArchitecture.Domain" Version="10.10.3" />
        <PackageReference Update="Dedsi.CleanArchitecture.HttpApi" Version="10.10.3" />
        <PackageReference Update="Dedsi.CleanArchitecture.Infrastructure" Version="10.10.3" />
        <PackageReference Update="FastEndpoints" Version="8.3.0" />
        <PackageReference Update="FastEndpoints.OpenApi" Version="8.3.0" />
        <PackageReference Update="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
        <PackageReference Update="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
        <PackageReference Update="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
        <PackageReference Update="Microsoft.EntityFrameworkCore" Version="10.0.13" />
        <PackageReference Update="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
        <PackageReference Update="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
        <PackageReference Update="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
        <PackageReference Update="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
        <PackageReference Update="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <!-- FastEndpoints.OpenApi 8.3.0 要求 [2.12.0, 3.0.0)，使用兼容的最新稳定版。 -->
        <PackageReference Update="Microsoft.OpenApi" Version="2.13.0" />
        <PackageReference Update="OpenIddict.Abstractions" Version="7.7.2" />
        <PackageReference Update="OpenIddict.AspNetCore" Version="7.7.2" />
        <PackageReference Update="OpenIddict.EntityFrameworkCore" Version="7.7.2" />
        <PackageReference Update="OpenIddict.Quartz" Version="7.7.2" />
        <PackageReference Update="OpenIddict.Validation.AspNetCore" Version="7.7.2" />
        <PackageReference Update="OpenIddict.Validation.SystemNetHttp" Version="7.7.2" />
        <PackageReference Update="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
        <PackageReference Update="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
        <PackageReference Update="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
        <PackageReference Update="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
        <PackageReference Update="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
        <PackageReference Update="Quartz.Extensions.Hosting" Version="4.6.0" />
        <PackageReference Update="Scalar.AspNetCore" Version="2.18.2" />
        <PackageReference Update="Serilog.AspNetCore" Version="10.0.0" />
        <PackageReference Update="Serilog.Sinks.Async" Version="2.1.0" />
        <PackageReference Update="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
        <PackageReference Update="Serilog.Sinks.Seq" Version="9.1.0" />
        <PackageReference Update="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
        <PackageReference Update="Volo.Abp.AspNetCore.Serilog" Version="10.7.0" />
        <PackageReference Update="Volo.Abp.Autofac" Version="10.7.0" />
        <PackageReference Update="Volo.Abp.BlobStoring.Minio" Version="10.7.0" />
        <PackageReference Update="Volo.Abp.EntityFrameworkCore.PostgreSql" Version="10.7.0" />
        <PackageReference Update="xunit" Version="2.9.3" />
        <PackageReference Update="xunit.runner.visualstudio" Version="4.0.1" />
    </ItemGroup>
</Project>
