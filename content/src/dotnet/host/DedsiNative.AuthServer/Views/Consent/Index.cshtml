@{
    ViewData["Title"] = "应用授权申请";
    var appName = ViewBag.ApplicationName as string ?? "第三方应用";
    var scopes = ViewBag.Scopes as List<(string Name, string DisplayName, string Description)> ?? new();
    var returnUrl = ViewBag.ReturnUrl as string ?? "/";
    var userName = ViewBag.UserName as string ?? "当前用户";
}

<div class="auth-card-container">
    <div class="auth-card">
        <!-- 品牌标识 Header -->
        <div class="auth-brand">
            <div class="auth-logo-badge">
                <span class="logo-grid-item logo-grid-1"></span>
                <span class="logo-grid-item logo-grid-2"></span>
                <span class="logo-grid-item logo-grid-3"></span>
                <span class="logo-grid-item logo-grid-4"></span>
            </div>
            <span class="auth-brand-name">DedsiNative</span>
        </div>

        <div class="user-identity-bar" style="margin-bottom: 1.25rem;">
            <div class="user-avatar-mini">👤</div>
            <span class="user-identity-text">@userName</span>
        </div>

        <h1 class="auth-title">请求访问权限</h1>
        <p class="auth-subtitle"><strong>@appName</strong> 正在申请获取您的账号以下权限：</p>

        <ul class="scope-list">
            @foreach (var scope in scopes)
            {
                <li class="scope-item">
                    <div class="scope-icon">
                        <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                        </svg>
                    </div>
                    <div class="scope-info">
                        <div class="scope-title">@scope.DisplayName</div>
                        @if (!string.IsNullOrEmpty(scope.Description))
                        {
                            <div class="scope-desc">@scope.Description</div>
                        }
                    </div>
                </li>
            }
        </ul>

        <div class="consent-warning">
            <p>点击“同意授权”即表示您允许该应用程序根据其服务条款和隐私声明使用您的信息。</p>
        </div>

        <div class="form-actions" style="margin-top: 1.75rem; justify-content: flex-end; gap: 0.75rem;">
            <form method="post" action="/Consent/Deny" style="display: inline-block;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-secondary btn-ms">拒绝</button>
            </form>
            <form method="post" action="/Consent" style="display: inline-block;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit" class="btn btn-primary btn-ms">同意授权</button>
            </form>
        </div>
    </div>
</div>
