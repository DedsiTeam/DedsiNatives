@page
@model DedsiNative.AuthServer.Pages.ErrorModel
@{
    ViewData["Title"] = "认证发生错误";
}

<div class="auth-card">
    <div class="auth-brand">
        <div class="auth-logo" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);">!</div>
        <h1 class="auth-title">请求发生错误</h1>
        <p class="auth-subtitle">身份认证或授权过程中遇到问题</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger" style="flex-direction: column; align-items: flex-start;">
            <div style="font-weight: 700;">@Model.Error</div>
            @if (!string.IsNullOrEmpty(Model.ErrorDescription))
            {
                <div style="margin-top: 0.25rem;">@Model.ErrorDescription</div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            <span>处理您的请求时发生意外错误。</span>
        </div>
    }

    @if (Model.ShowRequestId)
    {
        <p style="font-size: 0.75rem; color: var(--color-text-sub); text-align: center; margin-bottom: 1.5rem;">
            请求 ID: <code>@Model.RequestId</code>
        </p>
    }

    <a href="/" class="btn btn-secondary">返回首页</a>
</div>
