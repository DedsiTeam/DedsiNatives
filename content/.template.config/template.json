{
  "$schema": "http://json.schemastore.org/template",
  "author": "Cohen Wang",
  "classifications": [
    "Clean Architecture",
    "WebAPI",
    "ABP Framework",
    "PostgreSQL",
    "FastEndpoints"
  ],
  "identity": "DedsiNative.Template.CSharp.1.0",
  "name": "DedsiNative Clean Architecture",
  "description": "基于 ABP Framework、FastEndpoints 和 PostgreSQL 的 Clean Architecture 解决方案模板。",
  "shortName": "dedsi-native",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "DedsiNative",
  "preferNameDirectory": true,
  "symbols": {
    "HttpPort": {
      "type": "parameter",
      "datatype": "integer",
      "description": "后端 HTTP 服务端口。",
      "defaultValue": "12256",
      "replaces": "12256"
    },
    "AdoOrg": {
      "type": "parameter",
      "datatype": "string",
      "description": "Azure DevOps 组织名，用于 .codex/config.toml 中的 Local MCP PAT 连接。",
      "defaultValue": "CohenTeam",
      "replaces": "{{ADO_ORG}}"
    },
    "AdoProject": {
      "type": "parameter",
      "datatype": "string",
      "description": "Azure DevOps Project 名称，用于工作项 Loop。",
      "defaultValue": "DedsiNative",
      "replaces": "{{ADO_PROJECT}}"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "**/nupkg/**",
            "**/.idea/**",
            "**/.DS_Store",
            "**/Logs/**",
            "**/EntityFrameworkCore/Migrations/**",
            "**/*.DotSettings.user",
            ".template.config/**",
            "DedsiNative.Template.csproj",
            "README.md"
          ]
        }
      ]
    }
  ]
}
