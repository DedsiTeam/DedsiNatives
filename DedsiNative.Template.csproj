<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- NuGet 包类型必须为 Template -->
    <PackageType>Template</PackageType>
    <PackageId>DedsiNative.Template</PackageId>
    <PackageVersion>0.1.3</PackageVersion>
    <Title>DedsiNative Clean Architecture Template</Title>
    <Authors>Cohen Wang</Authors>
    <Description>基于 ABP Framework、FastEndpoints 和 PostgreSQL 的 Clean Architecture 解决方案模板。通过 `dotnet new dedsi-native -n YourProject` 快速创建项目。</Description>
    <PackageTags>dotnet-new;template;clean-architecture;abp;postgresql;fastendpoints;csharp;webapi</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- 模板包不包含程序集输出 -->
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>

    <!-- 禁用 SDK 自动包含，改为手动控制 -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- 抑制 lib/ 文件夹缺失的警告（模板包的正常情况） -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <!-- 输出到 nupkg 目录，避免与其他 obj/ 混淆 -->
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- README（包封面） -->
    <None Include="content/README.md" Pack="true" PackagePath="\" />

    <!-- 模板内容文件 (content 目录下所有内容) -->
    <Content Include="content/**/*"
             Exclude="content/**/.DS_Store;
                      content/**/bin/**;
                      content/**/obj/**;
                      content/**/Logs/**;
                      content/**/*.DotSettings.user;
                      content/**/EntityFrameworkCore/Migrations/**;
                      content/**/node_modules/**;
                      content/**/dist/**"
             PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

